{
  "manifest_version": 3,
  "name": "משוב פלוס",
  "version": "1.13.0",
  "description": "מצב כהה, חלוקת התפריט לקטגוריות וניווט מהיר במשוב תלמידים והורים",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://web.mashov.info/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.mashov.info/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "משוב פלוס",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "key": "",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}